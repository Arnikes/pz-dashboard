# Copy to .env beside docker-compose.yml. Never commit real credentials.
# Game server credentials (separate from the panel administrator).
RCON_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Single panel administrator; password must contain at least 12 characters.
PZ_ADMIN_LOGIN=admin
PZ_ADMIN_PASSWORD=
# Required session encryption key. Generate with:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
PZ_AUTH_KEY=
# Set true behind HTTPS. Leave false only for HTTP on a trusted network.
PZ_AUTH_COOKIE_SECURE=false
# Remembered sessions persist in dashboard-data; keep the encryption key stable.

# Display name, active game profile, and optional version fallback.
PZ_SERVER_NAME=Riverside Co-op
SERVER_NAME=pzserver
PZ_CONFIG_FILE=
PZ_VERSION=

# Panel CPU budget in CPU cores, independent of the game server's allocation.
# 0.5 = half one CPU; 0 disables the hard cap. Lower priority still applies.
PZ_DASHBOARD_CPUS=0.5

# New-server example uses the B42 unstable branch; blank selects the public branch.
SERVER_BRANCH=unstable
MEMORY_XMX_GB=8
MAX_PLAYERS=32

# Must match the Compose project containing the server.
COMPOSE_PROJECT_NAME=pz
TZ=UTC

# Optional S3 export for every new world backup (manual, scheduled and pre-change).
# Local archives are deleted only after verification, upload and SHA-256 read-back.
BACKUP_S3_ENABLED=false
BACKUP_S3_BUCKET=
# Empty uses AWS S3; set an https:// endpoint for S3-compatible storage.
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION=us-east-1
# Use a separate prefix per server. The panel applies the configured retention count.
BACKUP_S3_PREFIX=pz-backups
# auto (AWS default), path (e.g. MinIO), or virtual.
BACKUP_S3_ADDRESSING_STYLE=auto
# Credentials are passed only to the panel; never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
