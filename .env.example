# ─── Копируйте в .env рядом с docker-compose.yml и заполняйте ───

# Пароль RCON (тот же, что в конфиге pzserver)
RCON_PASSWORD=change-me-strong

# Единственный администратор пульта (создаётся при каждом запуске).
PZ_ADMIN_LOGIN=admin
# Обязательно задайте свой пароль, минимум 12 символов.
PZ_ADMIN_PASSWORD=
# Обязательный ключ шифрования cookie сессий; генерация без зависимостей:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
PZ_AUTH_KEY=
# true при доступе через HTTPS; для локальной сети по HTTP оставьте false.
PZ_AUTH_COOKIE_SECURE=false
# «Запомнить меня» сохраняет вход на 30 дней в /dashboard-data/auth-sessions.bin.
# Compose уже подключает постоянный volume; сохраняйте PZ_AUTH_KEY между рестартами.

# Название сервера (показывается в шапке пульта)
PZ_SERVER_NAME=Кастом-Нокс

# Необязательно: активный профиль и точная версия B42 для редакторов.
# При пустых значениях пульт определяет их из запуска контейнера и логов.
PZ_CONFIG_FILE=
PZ_VERSION=

# Часовой пояс
TZ=Europe/Moscow

# Имя проекта compose — должно совпадать с каталогом проекта
# (docker compose называет проект по имени папки)
COMPOSE_PROJECT_NAME=pz
