# ─── Копируйте в .env рядом с docker-compose.yml и заполняйте ───

# Пароль RCON (тот же, что в конфиге pzserver)
RCON_PASSWORD=change-me-strong

# Название сервера (показывается в шапке пульта)
PZ_SERVER_NAME=Кастом-Нокс

# Часовой пояс
TZ=Europe/Moscow

# Имя проекта compose — должно совпадать с каталогом проекта
# (docker compose называет проект по имени папки)
COMPOSE_PROJECT_NAME=pz
